# Copie para .env.local e preencha. Nunca faça commit do .env.local.
# Depois de alterar, reinicie o `npm run dev` (o Next só lê o arquivo ao iniciar).

# URL do projeto Supabase (Project Settings > Data API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Service role key (Project Settings > API Keys). No painel novo: "secret key" (sb_secret_...);
# no antigo (aba Legacy): "service_role" (eyJ...).
# SECRETA: usada só no servidor. Não use o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo para assinar o cookie de sessão (mínimo 32 caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

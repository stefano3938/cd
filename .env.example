# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# URL do projeto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Service role key (Settings > API). SECRETA: usada só no servidor. Não use o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo para assinar o cookie de sessão (mínimo 32 caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
